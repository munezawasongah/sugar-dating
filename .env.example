# ---------------------------------------------------------------
# Copy this to .env for local dev. In Railway, set these under
# your service's "Variables" tab instead — do not commit real values.
# ---------------------------------------------------------------

# Provided automatically if you add a Postgres plugin in your Railway
# project. Copy its DATABASE_URL reference into this service's variables
# (Railway lets you reference another service's variable directly).
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Session/auth secret — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# KYC/ID verification vendor — NO LONGER USED. Age verification is now
# handled by self-attestation at signup (see src/app/signup/page.tsx) plus
# the server-checked date of birth. These lines are kept here only in case
# you decide to reintroduce real ID verification later.
# KYC_VENDOR_API_KEY="persona_sandbox_or_live_key"
# KYC_TEMPLATE_ID="itmpl_xxxxxxxx"
# KYC_WEBHOOK_SECRET="whsec_xxxxxxxx"

# Media storage (Supabase Storage or Cloudflare R2)
STORAGE_BUCKET_URL="https://xxxx.supabase.co/storage/v1"
STORAGE_ACCESS_KEY="replace-me"
STORAGE_SECRET_KEY="replace-me"

# M-Pesa Daraja (Safaricom) — required for the KES 2,000 contact fee to
# actually charge real money. Without these set, payments are auto-approved
# in a "simulated" mode so you can test the rest of the flow — this does
# NOT collect real payments, so don't rely on it once real users are on the
# platform.
DARAJA_ENV="sandbox"
DARAJA_CONSUMER_KEY="replace-me"
DARAJA_CONSUMER_SECRET="replace-me"
DARAJA_SHORTCODE="174379"
DARAJA_PASSKEY="replace-me"
DARAJA_CALLBACK_URL="https://your-app.up.railway.app/api/webhooks/mpesa"

# Public URL of this deployment, used for KYC vendor redirect callbacks
NEXT_PUBLIC_APP_URL="https://your-app.up.railway.app"
